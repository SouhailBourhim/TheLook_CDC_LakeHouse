# Copy to onprem/.env and fill in. onprem/.env is git-ignored.

# Postgres superuser, used only for administration and setup scripts.
# The generator and Debezium get their own least-privilege roles later.
POSTGRES_DB=thelook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Login role for the generator; created by postgres/initdb on first start.
GENERATOR_DB_PASSWORD=change-me

# Generator iterations per second (each iteration = one purchase plus
# probabilistic side tasks). Low by default; raised in the baseline run.
GENERATOR_QPS=5

# Login role for Debezium (REPLICATION + SELECT); created by postgres/cdc-setup.sh.
DEBEZIUM_DB_PASSWORD=change-me

# Login role for postgres_exporter (pg_monitor only); created by
# postgres/apply-sql.sh postgres/monitoring-setup.sql.
EXPORTER_DB_PASSWORD=change-me

# MongoDB root user, created by the image on the first start; used only by
# mongo/setup.js (run by the mongo-init service) for administration.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me

# MongoDB login for the generator (writes web.events only); created and kept
# in sync by mongo/setup.js on every `up`.
MONGO_GENERATOR_PASSWORD=change-me

# MongoDB login for Debezium (read on the web database only); created by
# mongo/setup.js, used by connect/connectors/mongo-source.json.
DEBEZIUM_MONGO_PASSWORD=change-me

# Review simulator: read-only PostgreSQL role (postgres/reviewer-setup.sql,
# applied with apply-sql.sh) and MongoDB user limited to web.reviews
# (mongo/setup.js).
REVIEWER_DB_PASSWORD=change-me
MONGO_REVIEWER_PASSWORD=change-me

# AWS access key of IAM user thelook-spark-stream (infra/terraform/lake/iam.tf):
# writes s3://<lake>/bronze/ and Glue thelook_bronze only. Created with the
# AWS CLI, not Terraform (the secret would be in the state); see
# docs/runbook.md, "Spark AWS credentials". Used by the Spark streaming job (P3).
SPARK_STREAM_AWS_ACCESS_KEY_ID=
SPARK_STREAM_AWS_SECRET_ACCESS_KEY=

# AWS access key of IAM user thelook-spark-batch (iam.tf): reads bronze,
# reads/writes silver and gold. Created with the CLI like the stream key.
# Used by the silver/gold jobs and Airflow (P4); never the stream key there.
SPARK_BATCH_AWS_ACCESS_KEY_ID=
SPARK_BATCH_AWS_SECRET_ACCESS_KEY=

# The lake bucket (terraform -chdir=infra/terraform/lake output lake_bucket);
# its name contains the account id, so it is not committed.
LAKE_BUCKET=

# Airflow (P4, ADR 013): its metadata database, the key that encrypts stored
# connection passwords (Fernet, 32 url-safe base64 bytes), the secret that
# signs task tokens, and the UI's admin password (user "admin").
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
