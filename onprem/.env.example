# Copy to onprem/.env and fill in. onprem/.env is git-ignored.

# Postgres superuser, used only for administration and setup scripts.
# The generator and Debezium get their own least-privilege roles later.
POSTGRES_DB=thelook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Login role for the generator; created by postgres/initdb on first start.
GENERATOR_DB_PASSWORD=change-me

# Generator iterations per second (each iteration = one purchase plus
# probabilistic side tasks). Low by default; raised in the baseline run.
GENERATOR_QPS=5

# Login role for Debezium (REPLICATION + SELECT); created by postgres/cdc-setup.sh.
DEBEZIUM_DB_PASSWORD=change-me
