    {
      "id": 12,
      "type": "row",
      "title": "Orchestration (Airflow)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Gold age (O2: under 1 hour)",
      "description": "Since the start of the last successful transform run: a run reads bronze up to its start, so gold holds changes up to then.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(start_date)) AS gold_age FROM dag_run WHERE dag_id = 'transform' AND state = 'success'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Tasks running now",
      "description": "All DAGs. The lake pool lets one Spark job write silver and gold at a time (ADR 017).",
      "gridPos": {
        "x": 6,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT count(*) AS running FROM task_instance WHERE state = 'running'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Failed tasks, last 24 h",
      "description": "Each final failure is also an email (AirflowTaskFailed, ADR 020).",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT count(*) AS failed FROM task_instance WHERE state = 'failed' AND end_date > now() - interval '24 hours'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Tasks retried, last 24 h",
      "description": "Tasks that needed an Airflow retry. Network blips should be absorbed inside the jobs (with_retries, ~6.6 min): a retry here means a longer outage or a real error.",
      "gridPos": {
        "x": 18,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT count(*) AS retried FROM task_instance WHERE try_number > 1 AND start_date > now() - interval '24 hours'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Running now",
      "description": "Each running task, its try and how long it has run. Silver's catch-up after two days of downtime: ~30-40 min.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT dag_id AS dag, task_id AS task, try_number AS try, start_date AS started, round((EXTRACT(EPOCH FROM now() - start_date) / 60)::numeric, 1) AS running_min FROM task_instance WHERE state = 'running' ORDER BY start_date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Last run of each DAG",
      "description": "transform (every 30 min), maintenance and graph (daily), quality_report (daily), gdpr_erasure and backfill (on demand).",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT DISTINCT ON (dag_id) dag_id AS dag, run_type AS type, state, start_date AS started, end_date AS ended, round((EXTRACT(EPOCH FROM coalesce(end_date, now()) - start_date) / 60)::numeric, 1) AS minutes FROM dag_run WHERE start_date IS NOT NULL ORDER BY dag_id, start_date DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "transform: duration of each task (minutes)",
      "description": "silver, gold_dims, gold_facts, gold_marts, quality. Normal run: ~6-7 min in all (P4).",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT end_date AS time, task_id AS metric, duration / 60 AS value FROM task_instance WHERE dag_id = 'transform' AND state = 'success' AND $__timeFilter(end_date) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "transform: run duration (minutes)",
      "description": "From start to end, retries included. O2 holds while schedule (30 min) + run stays under an hour.",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow"
          },
          "rawSql": "SELECT end_date AS time, EXTRACT(EPOCH FROM end_date - start_date) / 60 AS run FROM dag_run WHERE dag_id = 'transform' AND state IN ('success', 'failed') AND $__timeFilter(end_date) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      }
    },
