# Secrets and local environment (never committed; .env.example documents the variables)
.env
*.pem

# Python (uv creates .venv/)
.venv/
__pycache__/
*.py[cod]

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Raw drill logs (summaries go in docs/results.md)
drills/logs/

# Terraform: provider downloads and state (state lives in S3; the bootstrap
# state is local and must not be committed)
.terraform/
*.tfstate
*.tfstate.*
crash.log
tfplan

# Terraform variable values (may contain personal data); see *.tfvars.example
*.tfvars
